#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
source "${SCRIPT_DIR}/../lib/common.sh"
# shellcheck source=../lib/log.sh
source "${SCRIPT_DIR}/../lib/log.sh"
# shellcheck source=../lib/crossover.sh
source "${SCRIPT_DIR}/../lib/crossover.sh"
# shellcheck source=../lib/eso_paths.sh
source "${SCRIPT_DIR}/../lib/eso_paths.sh"
# shellcheck source=../lib/eso_runtime.sh
source "${SCRIPT_DIR}/../lib/eso_runtime.sh"
# shellcheck source=../lib/eso_setup.sh
source "${SCRIPT_DIR}/../lib/eso_setup.sh"
# shellcheck source=../lib/dune_paths.sh
source "${SCRIPT_DIR}/../lib/dune_paths.sh"
# shellcheck source=../lib/dune_battleye.sh
source "${SCRIPT_DIR}/../lib/dune_battleye.sh"
# shellcheck source=../lib/dune_runtime.sh
source "${SCRIPT_DIR}/../lib/dune_runtime.sh"
# shellcheck source=../lib/dune_setup.sh
source "${SCRIPT_DIR}/../lib/dune_setup.sh"

usage() {
  cat <<EOF
crossover — CrossOver bottle scripts (macOS)

Usage:
  crossover [--no-color] eso paths [--json]     ESO: Mac/Windows/bottle paths (+ steam/minion)
  crossover [--no-color] eso doctor             ESO: health check
  crossover [--no-color] eso status             ESO: bottle process status (eso64/TTC/steam)
  crossover [--no-color] eso quit [--keep-steam] ESO: clean bottle exit (wineboot + wineserver)
  crossover [--no-color] eso start               ESO: start Steam + ESO + TTC (detached play session)
  crossover [--no-color] eso stop [--keep-steam]  ESO: alias for quit (clean bottle exit)
  crossover [--no-color] eso fix-ttc-net         ESO: TTC host/Wine DNS fix (hosts pin + probes)
  crossover [--no-color] eso setup [--skip-launchers] [--skip-gui-wait]
                                   ESO: Minion + launchers; GUI steps for Steam/ESO
  crossover [--no-color] eso launch steam         ESO: launch Steam in the bottle
  crossover [--no-color] eso launch game          ESO: launch ESO via Steam -applaunch
  crossover [--no-color] eso launch minion        ESO: launch native Minion.app (macOS)
  crossover [--no-color] eso launch ttc           ESO: launch Tamriel Trade Centre Client
  crossover [--no-color] dune paths [--json]      Dune: bottle/game/BattlEye paths
  crossover [--no-color] dune doctor              Dune: health check (BattlEye, AVX, game)
  crossover [--no-color] dune setup [--skip-gui-wait]
                                   Dune: AVX env + GUI steps for Steam/game
  crossover [--no-color] dune fix-battleye [--full-reset]
                                   Dune: repair BattlEye (Updating… hang)
  crossover [--no-color] dune verify-steam         Dune: Steam verify integrity (AppID 1172710)
  crossover [--no-color] dune launch steam        Dune: launch Steam in the bottle
  crossover [--no-color] dune launch game           Dune: launch via BattlEye wrapper
  crossover help                     Show this message

  --no-color          Disable ANSI colors (same as CROSSOVER_NO_COLOR=1)

Environment (ESO recipe):
  CROSSOVER_BOTTLE    Bottle name (default: ${ESO_DEFAULT_BOTTLE_NAME})
  CROSSOVER_ROOT      CrossOver SharedSupport root (auto-detected if unset)
  ESO_MAC_ADDONS      Mac live AddOns directory
  CROSSOVER_PREFIX    Override bottle drive_c prefix
  ESO_WIN_ADDONS      Windows-side AddOns path inside the bottle
  ESO_LAUNCHER_DIR    Desktop launcher output (default: ~/Desktop)
  ESO_SKIP_GUI_WAIT   Set to 1 (or use --skip-gui-wait) to skip the interactive bottle prompt
  ESO_MINION_MAC_APP   Path to Minion.app (default: /Applications/Minion.app)
  CROSSOVER_NO_COLOR  Set to 1/true/yes to disable ANSI colors (or use --no-color)

Environment (Dune recipe):
  CROSSOVER_BOTTLE    Bottle name (default: ${DUNE_DEFAULT_BOTTLE_NAME})
  CROSSOVER_ROOT      CrossOver SharedSupport root (auto-detected if unset)
  DUNE_STRICT_DOCTOR  Set to 1 to require CrossOver + bottle checks in doctor
  DUNE_SKIP_GUI_WAIT  Set to 1 (or use --skip-gui-wait) to skip the interactive bottle prompt
  CROSSOVER_PREFIX    Override bottle drive_c prefix

EOF
}

eso_cmd_paths() {
  if [[ "${1:-}" == "--json" ]]; then
    eso_paths_extended_json
    return 0
  fi
  if [[ -n "${1:-}" ]]; then
    log_error "unknown option for paths: $1"
    return 2
  fi
  eso_paths_print
}

eso_cmd_launch() {
  local target="${1:-}"
  shift || true
  case "$target" in
    steam)
      eso_launch_steam "$@"
      ;;
    game)
      eso_launch_game "$@"
      ;;
    minion)
      eso_launch_minion "$@"
      ;;
    ttc)
      eso_launch_ttc "$@"
      ;;
    *)
      log_error "unknown launch target: ${target:-<missing>} (use steam, game, minion, or ttc)"
      return 2
      ;;
  esac
}

eso_main() {
  local -a args=()
  log_filter_argv args "$@"
  set -- "${args[@]}"

  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    paths)
      eso_cmd_paths "$@"
      ;;
    doctor)
      eso_doctor "$@"
      ;;
    status)
      eso_status_print "$@"
      ;;
    quit)
      eso_quit "$@"
      ;;
    start)
      eso_start "$@"
      ;;
    stop)
      eso_stop "$@"
      ;;
    fix-ttc-net)
      eso_fix_ttc_net "$@"
      ;;
    setup)
      eso_setup_run "$@"
      ;;
    launch)
      eso_cmd_launch "$@"
      ;;
    help | -h | --help)
      usage
      ;;
    *)
      log_error "unknown eso command: $cmd"
      usage >&2
      return 2
      ;;
  esac
}

dune_cmd_paths() {
  if [[ "${1:-}" == "--json" ]]; then
    dune_paths_json
    return 0
  fi
  if [[ -n "${1:-}" ]]; then
    log_error "unknown option for paths: $1"
    return 2
  fi
  dune_paths_print
}

dune_cmd_launch() {
  local target="${1:-}"
  shift || true
  case "$target" in
    steam)
      dune_launch_steam "$@"
      ;;
    game)
      dune_launch_game "$@"
      ;;
    *)
      log_error "unknown launch target: ${target:-<missing>} (use steam or game)"
      return 2
      ;;
  esac
}

dune_main() {
  local -a args=()
  log_filter_argv args "$@"
  set -- "${args[@]}"

  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    paths)
      dune_cmd_paths "$@"
      ;;
    doctor)
      dune_doctor "$@"
      ;;
    setup)
      dune_setup_run "$@"
      ;;
    fix-battleye)
      dune_battleye_fix "$@"
      ;;
    verify-steam)
      dune_verify_steam "$@"
      ;;
    launch)
      dune_cmd_launch "$@"
      ;;
    help | -h | --help)
      usage
      ;;
    *)
      log_error "unknown dune command: $cmd"
      usage >&2
      return 2
      ;;
  esac
}

main() {
  local -a args=()
  log_filter_argv args "$@"
  set -- "${args[@]}"

  local recipe="${1:-help}"
  shift || true

  case "$recipe" in
    eso)
      eso_main "$@"
      ;;
    dune)
      dune_main "$@"
      ;;
    help | -h | --help)
      usage
      ;;
    *)
      log_error "unknown recipe: $recipe (available: eso, dune)"
      usage >&2
      return 2
      ;;
  esac
}

main "$@"
